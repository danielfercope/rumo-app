# Copie para infra/.env (gitignored) e preencha com valores reais.
# Usado pelo docker-compose.backend.yml (db + postgrest + Backend + Caddy).

POSTGRES_PASSWORD=postgres
AUTHENTICATOR_PASSWORD=authenticator

# Compartilhado entre postgrest e o Backend — PRECISA ter pelo menos 32 bytes
# (o PostgREST rejeita silenciosamente, como "assinatura inválida", segredos
# menores que isso). Gere um valor forte com `openssl rand -hex 32` e nunca
# reutilize o exemplo abaixo.
INTERNAL_JWT_SECRET=dev-secret-de-pelo-menos-32-bytes-troque-isto

# Projeto Firebase já usado pelo app (Crashlytics/Analytics/Auth).
FIREBASE_PROJECT_ID=rumo-app-b05fe

# Migrados do .env do Flutter — agora só vivem no Backend, nunca no app.
HUBSPOT_TOKEN=
TOKEN_EMPRESA_AQUI=

# Baixe o JSON da service account em:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# e salve em infra/firebase-service-account.json (gitignored).
