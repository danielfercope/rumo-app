# Copie para infra/.env (gitignored) e preencha com valores reais.
# Usado pelo docker-compose.backend.yml (db + postgrest + Backend + Caddy).
# Nenhum valor abaixo é um segredo de verdade — são só placeholders.

# Gere com `openssl rand -hex 24` (ou similar). Sem valor, o compose falha
# ao subir — de propósito, pra nunca existir uma senha hardcoded no repo.
POSTGRES_PASSWORD=<gere-uma-senha-forte>
AUTHENTICATOR_PASSWORD=<gere-uma-senha-forte>

# Compartilhado entre postgrest e o Backend — PRECISA ter pelo menos 32 bytes
# (o PostgREST rejeita silenciosamente, como "assinatura inválida", segredos
# menores que isso). Gere com `openssl rand -hex 32`.
INTERNAL_JWT_SECRET=<gere-com-openssl-rand--hex-32>

# Projeto Firebase já usado pelo app (Crashlytics/Analytics/Auth).
FIREBASE_PROJECT_ID=rumo-app-b05fe

# Migrados do .env do Flutter — agora só vivem no Backend, nunca no app.
# CRM_TOKEN é o token do provedor de CRM atual (HubSpot — private app token).
# CRM_CNPJ_PROPERTY_NAME é o nome INTERNO (não o label) da propriedade
# customizada de CNPJ no objeto Company do CRM — ajuste depois de criá-la.
CRM_TOKEN=
CRM_CNPJ_PROPERTY_NAME=cnpj

# Baixe o JSON da service account em:
# Firebase Console → Project Settings → Service Accounts → Generate new private key
# e salve em infra/firebase-service-account.json (gitignored).

# Sincronização CRM -> banco (a cada CRM_SYNC_INTERVAL_SECONDS traz as empresas
# novas do CRM, já enriquecidas e geocodificadas). Deixe false até rodar o
# backfill inicial: `docker compose -f docker-compose.backend.yml exec backend
# python -m app.scripts.crm_backfill`.
CRM_SYNC_ENABLED=false
CRM_SYNC_INTERVAL_SECONDS=600

# Sincronização por organização (carteira de cada uma, com o token de CRM que
# ela fornece). CRM_TOKEN_ENCRYPTION_KEY cifra esses tokens no banco — gere com:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Guarde a chave (Secrets Manager): perdê-la ou trocá-la obriga todas as
# organizações a reconectar o CRM.
CRM_CONNECTIONS_SYNC_ENABLED=false
CRM_TOKEN_ENCRYPTION_KEY=
# Chave de SERVIDOR da Google Geocoding API (sem restrição de referrer).
GEOCODING_API_KEY=
