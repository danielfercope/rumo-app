// Copie pra Secrets.xcconfig (gitignored) e preencha com a chave real.
// GOOGLE_MAPS_API_KEY é lida pelo AppDelegate.swift via Info.plist
// (GMSServices.provideAPIKey) — é a mesma chave do GOOGLE_API_KEY do .env
// da raiz do projeto, só que o código nativo iOS não lê --dart-define,
// então precisa chegar até aqui por esse caminho separado.
GOOGLE_MAPS_API_KEY = sua-chave-aqui
